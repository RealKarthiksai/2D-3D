<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Push-to-talk voice commands only (on-device recogniser, no network): optional hardware, runtime permission after a rationale. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:label="@string/app_name" android:allowBackup="false" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ConsentActivity" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".SettingsActivity" />
        <!-- Debug design gallery; MainActivity links to it only in debuggable builds. -->
        <activity android:name=".DesignGalleryActivity" android:exported="false" />
        <activity android:name=".RecorderActivity" android:screenOrientation="landscape" android:theme="@style/AppTheme.Camera" />
        <!-- uiMode: a light/dark switch mid-scan must not recreate the activity (that would end the scan). -->
        <activity android:name=".CaptureActivity" android:screenOrientation="landscape" android:theme="@style/AppTheme.Camera" android:configChanges="uiMode" />
        <activity android:name=".ReviewActivity" />
        <activity android:name=".ClockCheckActivity" android:screenOrientation="landscape" android:theme="@style/AppTheme.Camera" />
        <meta-data android:name="com.google.ar.core" android:value="required" />
    </application>
</manifest>
